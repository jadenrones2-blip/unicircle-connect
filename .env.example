# ── UniCircle Connect — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
# Get all values from the team Notion page: [add your Notion link here]

# ── Supabase (Main DB — auth, profiles, applicants, recruitment) ──────────────
VITE_SUPABASE_PROJECT_ID=xvaoxmqmnmhbnpwobpmm
VITE_SUPABASE_URL=https://xvaoxmqmnmhbnpwobpmm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=        # Supabase anon key — get from Notion

# ── Notes ─────────────────────────────────────────────────────────────────────
# Edge function secrets (ANTHROPIC_API_KEY, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY)
# are stored in Supabase directly — NOT in this file.
# To set them: supabase secrets set KEY=value --project-ref xvaoxmqmnmhbnpwobpmm
# Current secrets are listed in the Notion engineering doc.
